# Cloudflare Pages response headers.
# vercel.json set no custom headers; these are safe defaults for a static site.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# No long immutable Cache-Control on /assets/*: a missing asset path gets the SPA
# fallback (index.html, 200), and that HTML must not be cached for a year under a
# .js URL. Pages' default ETag revalidation is used instead.
